# --- Talentsoft (tenant du client) ---------------------------------------------------
TS_BASE_URL=https://<tenant>.talent-soft.com
TS_USERNAME=compte.technique@client.fr
TS_PASSWORD=change-me
# Gabarit d'URL d'une fiche candidature, à confirmer en phase 0 (docs/DISCOVERY.md).
# Doit contenir {application_id}. {base} = TS_BASE_URL.
TS_APPLICATION_URL_TEMPLATE={base}/Recruiting/BackOffice/Applications/{application_id}
# Valeurs par défaut si l'appelant ne les fournit pas (libellé ou code du référentiel)
TS_DEFAULT_EVENT_TYPE=Commentaire
TS_DEFAULT_DOCUMENT_CATEGORY=Autre
# Candidature témoin (lecture seule) pour POST /selftest et les référentiels
TS_SELFTEST_APPLICATION_ID=

# --- API --------------------------------------------------------------------------------
API_TOKEN=change-me-long-random-token
# Rotation sans coupure : ancien token accepté le temps de mettre à jour Hippolyte.ai, puis retirer
API_TOKEN_PREVIOUS=
# Port hôte publié par docker-compose (127.0.0.1 uniquement)
API_HOST_PORT=42201
ENABLE_API_DOCS=false
COMMENT_MAX_CHARS=4000
IDEMPOTENCY_TTL_SECONDS=86400

# --- Uploads ----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,odt,rtf,txt,png,jpg,jpeg

# --- Navigateur -------------------------------------------------------------------------
HEADLESS_MODE=true
# Chemin explicite d'un Chromium (vide = navigateur fourni par l'image Playwright)
BROWSER_EXECUTABLE_PATH=
ACTION_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=45000
JOB_TIMEOUT_SECONDS=300
BROWSER_RETRY_AFTER_SECONDS=60
BROWSER_MAX_QUEUED=2
BROWSER_ADMITTED_LOCK_TIMEOUT_SECONDS=1800
BROWSER_SESSION_IDLE_TTL_SECONDS=1800
BROWSER_SESSION_MAX_AGE_SECONDS=7200
# Au-delà de N échecs de login en FENETRE secondes : état dégradé, plus aucune tentative (protège le compte)
LOGIN_MAX_FAILURES=3
LOGIN_FAILURE_WINDOW_SECONDS=600

# --- Observabilité (traces = données personnelles : désactivé par défaut en production) -----
TRACES_ENABLED=false
SCREENSHOTS_ENABLED=false
TRACES_RETENTION_DAYS=7

# --- Jobs async (profil docker compose "async") ---------------------------------------------
# REDIS_URL=redis://redis:6379/0
# TS_ASYNC_JOBS_ENABLED=true
