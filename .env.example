# --- Talentsoft (tenant du client) ---------------------------------------------------
# Back Office RECRUTEMENT. Attention : ce n'est pas l'hôte sur lequel on atterrit après
# authentification (celui-là est l'espace collaborateur MyTalentsoft). Voir docs/DISCOVERY.md.
TS_BASE_URL=https://<tenant>-rh.talent-soft.com
TS_USERNAME=compte.technique@client.fr
TS_PASSWORD=change-me

# Hôtes TRAVERSÉS pendant l'authentification, en plus de TS_BASE_URL. Sans cette allowlist,
# la navigation est bloquée et le bot ne peut pas se connecter.
# Le parcours en compte trois, tous distincts de TS_BASE_URL :
#   1. la passerelle de fédération (écran « Sélectionnez le compte »)
#   2. le fournisseur d'identité (formulaire identifiant / mot de passe)
#   3. l'espace collaborateur, sur lequel le SSO ATTERRIT avant que le bot rejoigne le
#      Back Office. Oublier celui-ci fait échouer le login à la toute dernière étape.
# Exemple pour un tenant « client » : fedauth.talent-soft.com,idp.talent-soft.com,client.talent-soft.com
TS_AUTH_HOSTS=<federation>.talent-soft.com,<idp>.talent-soft.com,<espace-collaborateur>.talent-soft.com

# Compte à choisir sur l'écran « Sélectionnez le compte ... ».
# Accepte l'IDENTIFIANT du fournisseur d'identité (ex. `airfrance.fr`) ou le libellé affiché.
# Préférer l'identifiant : les libellés du tenant sont accentués (« Accès @rtémis pour ... »),
# ce qui les rend fragiles à transporter dans un fichier .env.
# Les valeurs disponibles sont journalisées au démarrage (`account_choice_options`).
# Laisser vide s'il n'y a qu'une seule option. Si plusieurs options et valeur vide,
# le bot refuse de deviner (se tromper de compte donnerait un périmètre inattendu).
TS_ACCOUNT_CHOICE=

# Liste des candidatures d'une offre. Doit contenir {offer_id}. {base} = TS_BASE_URL.
TS_OFFER_URL_TEMPLATE={base}/Pages/Offers/MainPage.aspx?FromContext=VacancyDashboard&id={offer_id}

# Valeurs par défaut si l'appelant ne les fournit pas.
# ATTENTION : ces libellés sont propres au tenant et doivent exister dans son référentiel.
# Les relever avec GET /referentials/event-types et /referentials/document-categories.
# Ne JAMAIS choisir un type d'événement qui déclenche l'envoi d'un courrier au candidat.
TS_DEFAULT_EVENT_TYPE=
TS_DEFAULT_DOCUMENT_CATEGORY=Autres documents

# Candidature témoin (lecture seule) pour POST /selftest et la lecture des référentiels.
# Une candidature n'est pas adressable par un identifiant unique : il faut le couple.
TS_SELFTEST_CANDIDATE_EMAIL=
TS_SELFTEST_OFFER_ID=

# --- API --------------------------------------------------------------------------------
API_TOKEN=change-me-long-random-token
# Rotation sans coupure : ancien token accepté le temps de mettre à jour Hippolyte.ai, puis retirer
API_TOKEN_PREVIOUS=
# Port hôte publié par docker-compose (127.0.0.1 uniquement)
API_HOST_PORT=42201
ENABLE_API_DOCS=false
# Le champ commentaire du Back Office porte maxlength=2000 : au-delà il tronquerait
# silencieusement. La valeur est plafonnée à 2000 par le code, un commentaire plus long
# est refusé (400) plutôt que tronqué.
COMMENT_MAX_CHARS=2000
IDEMPOTENCY_TTL_SECONDS=86400

# --- Uploads ----------------------------------------------------------------------------
# Limite affichée par le Back Office : 10240 Ko.
MAX_UPLOAD_SIZE_BYTES=10485760
# Extensions réellement acceptées par Talentsoft. Ni odt, ni txt, ni png/jpg : un fichier
# de ce type serait accepté par le bot puis rejeté par le Back Office.
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,rtf,tif,tiff,xlsx,zip

# --- Navigateur -------------------------------------------------------------------------
HEADLESS_MODE=true
# Chemin explicite d'un Chromium (vide = navigateur fourni par l'image Playwright)
BROWSER_EXECUTABLE_PATH=
# User-agent impose au navigateur. Vide : un user-agent de bureau est utilise en headless,
# ou Chromium annoncerait sinon « HeadlessChrome » — que des fournisseurs d'identite refusent
# SANS message d'erreur (le formulaire est accepte, l'authentification n'aboutit pas).
BROWSER_USER_AGENT=
ACTION_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=45000
JOB_TIMEOUT_SECONDS=300
BROWSER_RETRY_AFTER_SECONDS=60
BROWSER_MAX_QUEUED=2
BROWSER_ADMITTED_LOCK_TIMEOUT_SECONDS=1800
# Inactivite avant recyclage de la session. A regler SUR LA CADENCE REELLE des appels : avec des
# pushs horaires et 1800 s, la session expirait entre chaque, et le bot se reconnectait presque a
# tous les jobs. Chaque login est une occasion d echouer — c est sur une session fraichement
# ouverte qu un navigateur a ete perdu en recette. A la valeur du max-age, c est l age de la
# session qui gouverne le recyclage, plus l inactivite.
BROWSER_SESSION_IDLE_TTL_SECONDS=7200
BROWSER_SESSION_MAX_AGE_SECONDS=7200
# Au-delà de N échecs de login en FENETRE secondes : état dégradé, plus aucune tentative (protège le compte)
LOGIN_MAX_FAILURES=3
LOGIN_FAILURE_WINDOW_SECONDS=600

# --- Observabilité (traces = données personnelles : désactivé par défaut en production) -----
TRACES_ENABLED=false
SCREENSHOTS_ENABLED=false
TRACES_RETENTION_DAYS=7

# --- Attente des appels synchrones ----------------------------------------------------------
# En mode worker, un appel synchrone attend le resultat de son job puis bascule en 202 si le
# budget est depasse. Garder ces valeurs SOUS le read timeout du reverse proxy, sans quoi le
# client recoit une coupure au lieu du 202 qui lui dit ou suivre son job.
SYNC_WAIT_TIMEOUT_SECONDS=120
SYNC_READ_WAIT_TIMEOUT_SECONDS=60

# --- Jobs async (profil docker compose "async") ---------------------------------------------
# ATTENTION : des que le worker tourne, il est le SEUL a piloter un navigateur. L'api doit donc
# avoir TS_ASYNC_JOBS_ENABLED=true elle aussi, sinon elle ouvre son propre Chromium en plus du
# sien : le tenant n'admet qu'une session par compte technique, et les deux se deconnectent
# mutuellement jusqu'a l'etat degrade. Voir ARCHITECTURE.md.
# Viser le conteneur par SON nom, pas par le nom generique « redis » : sur un hote qui
# heberge plusieurs projets, « redis » peut designer le Redis d un voisin, que le bot
# joindrait sans le savoir (symptome : AuthenticationError, l API repond alors 503).
# REDIS_URL=redis://talentsoft_bot_redis:6379/0
# Redis externe protege par un mot de passe :
#   REDIS_URL=redis://:MOT_DE_PASSE@hote:6379/0
# TS_ASYNC_JOBS_ENABLED=true
